 "id": "p6-raise",
 "code": "class InsufficientFunds(Exception):\n    pass\n\ndef withdraw(balance, amount):\n    if amount > balance:\n        raise InsufficientFunds(f\"잔액 {balance}, 요청 {amount}\")\n    return balance - amount\n\ntry:\n    withdraw(100, 150)\nexcept InsufficientFunds as e:\n    print(\"실패:\", e)\n\ntry:\n    try:\n        int(\"x\")\n    except ValueError as e:\n        raise RuntimeError(\"설정 파싱 실패\") from e\nexcept RuntimeError as e:\n    print(e, \"| 원인:\", repr(e.__cause__))",
