 "code": "class Date:\n    def __init__(self, y, m, d):\n        self.y, self.m, self.d = y, m, d\n\n    @classmethod\n    def from_str(cls, text):\n        y, m, d = map(int, text.split(\"-\"))\n        return cls(y, m, d)\n\n    @staticmethod\n    def is_leap(y):\n        return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)\n\nd = Date.from_str(\"2026-09-08\")\nprint(d.y, d.m, d.d)\nprint(Date.is_leap(2024), d.is_leap(2026))",
